# Daily unit test report to Microsoft Teams (yarn test:report, scheduled by start-unit-test-report.sh).
# Read from .env, .env.dev, then .env.prod, the first file to set a key winning, like the app's own config.

# The URL of a Teams "When a Teams webhook request is received" workflow (Power Automate) that posts to the
# channel. Unset, the tests still run and the result is only printed.
UNIT_TESTS_WEBHOOK_URL=

# Optional. Comma separated, each an email or "Full Name <email>", @mentioned when the run is not green.
UNIT_TESTS_MENTION_ON_FAILURE=

# Optional. A label for the card title, e.g. prod.
UNIT_TESTS_REPORT_ENV=
