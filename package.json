{
  "name": "collection-web-scraper",
  "version": "0.0.1",
  "description": "",
  "repository": "https://github.com/mediamine/collection-web-scraper.git",
  "author": "MohsinKhan-MediaMine <mohsin@mediamine.co.nz>",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "yarn test:ci",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "postinstall-temp": "yarn run prisma:generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "test:report": "ts-node scripts/unit-test-report/run.ts",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:playwright": "yarn --cwd test playwright test",
    "nest:service": "nest g service",
    "prisma:generate": "prisma generate",
    "start:complete-scan": "yarn start [workflow=WORKFLOW_COMPLETE_SCAN]",
    "start:page-text-scan": "yarn start [workflow=WORKFLOW_PAGE_TEXT_SCAN]",
    "start:page-text-scan-v2": "yarn start [workflow=WORKFLOW_PAGE_TEXT_SCAN_V2]"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@playwright/test": "^1.47.2",
    "@prisma/client": "^5.19.1",
    "bcrypt": "^5.1.1",
    "hash-it": "^6.0.0",
    "lodash": "^4.17.21",
    "luxon": "^3.5.0",
    "prisma": "^5.19.1",
    "reflect-metadata": "^0.2.0",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/lodash": "^4.17.7",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^4.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/scripts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "clearMocks": true,
    "restoreMocks": true,
    "collectCoverageFrom": [
      "src/**/*.ts",
      "scripts/**/*.ts",
      "!**/*.spec.ts",
      "!src/testing/**"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coverageReporters": [
      "text",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      }
    }
  }
}
